{
  "name": "financo",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "devcontainer",
  "postStartCommand": {
    "node:install:dependencies": "npm install -g npm@latest && npm install",
    "go:install:dependencies": "go mod download",
    "application:setup": "make db-setup"
  },
  "workspaceFolder": "/workspaces/financo",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "davidanson.vscode-markdownlint",
        "shardulm94.trailing-spaces",
        "IBM.output-colorizer",
        "rangav.vscode-thunder-client",
        "donjayamanne.githistory",
        "streetsidesoftware.code-spell-checker",
        "bradlc.vscode-tailwindcss",
        "tamasfe.even-better-toml",
        "Gruntfuggly.todo-tree",
        "eamodio.gitlens",
        "Catppuccin.catppuccin-vsc-icons",
        "Catppuccin.catppuccin-vsc",
        "bierner.markdown-preview-github-styles",
        "bierner.github-markdown-preview",
        "bierner.markdown-mermaid",
        "mhutchie.git-graph",
        "cweijan.vscode-database-client2",
        "streetsidesoftware.code-spell-checker-spanish",
        "dbaeumer.vscode-eslint",
        "GitHub.vscode-github-actions",
        "GitHub.github-vscode-theme",
        "ms-azuretools.vscode-docker",
        "GitHub.copilot-chat",
        "GitHub.copilot"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "window.autoDetectColorScheme": true,
        "workbench.editor.wrapTabs": true,
        "workbench.preferredDarkColorTheme": "GitHub Dark",
        "workbench.preferredHighContrastColorTheme": "GitHub Dark High Contrast",
        "workbench.preferredLightColorTheme": "GitHub Light",
        "workbench.preferredHighContrastLightColorTheme": "GitHub Light High Contrast",
        "workbench.iconTheme": "catppuccin-mocha",
        "workbench.sideBar.location": "right",
        "editor.rulers": [
          80,
          120
        ],
        "editor.pasteAs.preferences": [
          "text.updateImports.jsts"
        ],
        "editor.linkedEditing": true,
        "javascript.preferences.renameMatchingJsxTags": true,
        "typescript.preferences.renameMatchingJsxTags": true,
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 120,
        "editor.formatOnSave": true,
        "editor.fontSize": 16,
        "editor.fontLigatures": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "files.associations": {
          "*.css": "tailwindcss"
        },
        "go.buildTags": "development",
        "terminal.integrated.fontSize": 16,
        "chat.editor.fontSize": 16,
        "markdown.preview.fontSize": 16,
        "markdown.preview.lineHeight": 1.1,
        "gopls": {
          "ui.semanticTokens": true,
          "ui.diagnostic.staticcheck": true
        },
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        },
        "typescript.preferences.autoImportSpecifierExcludeRegexes": [
          "@radix-ui",
          "radix-ui",
          "^lucide-react/dist/lucide-react.suffixed$"
        ],
        "[javascript]": {
          "editor.tabSize": 2
        },
        "[javascriptreact]": {
          "editor.tabSize": 2
        },
        "[typescript]": {
          "editor.tabSize": 2
        },
        "[typescriptreact]": {
          "editor.tabSize": 2
        },
        "[json]": {
          "editor.quickSuggestions": {
            "strings": true
          },
          "editor.suggest.insertMode": "replace",
          "editor.tabSize": 2
        }
      }
    }
  }
}