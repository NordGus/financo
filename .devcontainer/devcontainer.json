// IMPORTANT: This devcontainer expects to be running in a host machine that has docker install on it.

{
  "name": "financo",
  "build": {
    "dockerfile": "devcontainer-v2.Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "true",
      "configureZshAsDefaultShell": "true",
      "username": "programisto",
      "userUid": "1001",
      "userGid": "1001",
      "upgradePackages": "true"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": "false"
    },
    "ghcr.io/devcontainers-extra/features/fzf:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
      "plugins": "git copyfile extract colorize dotenv encode64 golang npm node fzf zsh-autosuggestions",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.23.6"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "shutdownAction": "stopContainer",
  "workspaceFolder": "/financo",
  "remoteUser": "programisto",
  "containerUser": "programisto",
  "capAdd": ["SYS_PTRACE"],
  "securityOpt": ["seccomp=unconfined"],
  "containerEnv": {
    "ZSH_THEME": "amuse",
    "DB_DATABASE": "financo_dev",
    "DB_PASSWORD": "local_dev",
    "DB_USERNAME": "financo",
    "DB_PORT": "5432",
    "DB_HOST": "localhost",
    "DB_SCHEMA": "public",
    "GOOSE_DRIVER": "postgres",
    "GOOSE_DBSTRING": "host=${DB_HOST} user=${DB_USERNAME} password=${DB_PASSWORD} database=${DB_DATABASE} sslmode=disable",
    "GOOSE_MIGRATION_DIR": "database/migrations"
  },
  "forwardPorts": [3000],
  "mounts": [
    {
      "type": "bind",
      "source": ".",
      "target": "/financo"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.ssh",
      "target": "/home/programisto/.ssh:ro"
    }
  ],
  "postAttachCommand": {
    "go:install:air": "go install github.com/air-verse/air@latest",
    "go:install:goose": "go install github.com/pressly/goose/v3/cmd/goose@latest",
    "node:install:dependencies": "npm install -g npm@latest && npm install",
    "disabling:dirty:indicator": "git config devcontainers-theme.hide-status 1",
    "git:config:safe.directory": "git config --global --add safe.directory /financo",
    "go:install:dependencies": "go mod download",
    "npm:install:dependencies": "npm install"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "davidanson.vscode-markdownlint",
        "shardulm94.trailing-spaces",
        "IBM.output-colorizer",
        "rangav.vscode-thunder-client",
        "donjayamanne.githistory",
        "streetsidesoftware.code-spell-checker",
        "bradlc.vscode-tailwindcss",
        "tamasfe.even-better-toml",
        "Gruntfuggly.todo-tree",
        "eamodio.gitlens",
        "Catppuccin.catppuccin-vsc-icons",
        "Catppuccin.catppuccin-vsc",
        "bierner.markdown-preview-github-styles",
        "bierner.github-markdown-preview",
        "bierner.markdown-mermaid",
        "mhutchie.git-graph",
        "cweijan.vscode-database-client2",
        "streetsidesoftware.code-spell-checker-spanish",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "window.autoDetectColorScheme": true,
        "workbench.preferredDarkColorTheme": "GitHub Dark Colorblind (Beta)",
        "workbench.preferredHighContrastColorTheme": "GitHub Dark High Contrast",
        "workbench.preferredLightColorTheme": "GitHub Light Colorblind (Beta)",
        "workbench.preferredHighContrastLightColorTheme": "GitHub Light High Contrast",
        "workbench.iconTheme": "catppuccin-mocha",
        "editor.rulers": [
          80,
          120
        ],
        "editor.pasteAs.preferences": [
          "text.updateImports.jsts"
        ],
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 120,
        "editor.formatOnSave": true,
        "editor.fontSize": 16,
        "editor.fontLigatures": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "files.associations": {
          "*.css": "tailwindcss"
        },
        "terminal.integrated.fontSize": 16,
        "chat.editor.fontSize": 16,
        "markdown.preview.fontSize": 16,
        "markdown.preview.lineHeight": 1.1,
        "gopls": {
          "ui.semanticTokens": true
        },
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        },
        "[javascript]": {
          "editor.tabSize": 2
        },
        "[javascriptreact]": {
          "editor.tabSize": 2
        },
        "[typescript]": {
          "editor.tabSize": 2
        },
        "[typescriptreact]": {
          "editor.tabSize": 2
        },
        "[json]": {
          "editor.quickSuggestions": {
            "strings": true
          },
          "editor.suggest.insertMode": "replace",
          "editor.tabSize": 2
        }
      }
    }
  }
}