export DB_DATABASE=financo_dev
export DB_PASSWORD=local_dev
export DB_USERNAME=financo
export DB_PORT=5432
export DB_HOST=0.0.0.0
export DB_SCHEMA=public
export GOOSE_DRIVER=postgres
export GOOSE_DBSTRING="host=$DB_HOST user=$DB_USERNAME password=$DB_PASSWORD database=$DB_DATABASE sslmode=disable"
export GOOSE_MIGRATION_DIR=database/migrations
